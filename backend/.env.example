# Environment variables for PharmaLLM Backend
# Copy this file to .env and configure as needed

# Flask Settings
SECRET_KEY=pharma-llm-dev-secret-key-change-in-production
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Model Settings
MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0
LORA_ADAPTER_PATH=./models/pharma-llm-lora
USE_LORA=True

# Generation Parameters
MAX_NEW_TOKENS=256
TEMPERATURE=0.7
TOP_P=0.9
TOP_K=50

# Device (auto-detected, but can override)
# DEVICE=cuda  # or 'cpu'

# Data Paths
DATA_DIR=./data

# NLTK
NLTK_DATA_PATH=./nltk_data

# Upload Settings
UPLOAD_FOLDER=./uploads

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Language Settings
DEFAULT_LANGUAGE=en
TTS_LANG=en
TTS_SLOW=False

# OpenAI API Key (optional, for dataset generation)
# OPENAI_API_KEY=your-api-key-here
